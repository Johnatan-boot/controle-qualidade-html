# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o arquivo ".env" para o Git nem para a pasta "public/".

# Segredo usado para assinar os tokens de login (JWT). Gere um valor
# longo e aleatório, por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_valor_por_um_segredo_longo_e_aleatorio

# Porta em que o servidor Express vai rodar (o Render define isso sozinho em produção).
PORT=3000

# Marque como "true" em produção (HTTPS). Em desenvolvimento local (http) deixe "false".
COOKIE_SECURE=false

# ---- Conexão com o MySQL ----
# Se estiver usando Render + Clever Cloud com o add-on de MySQL conectado,
# essas variáveis já são injetadas automaticamente com o prefixo MYSQL_ADDON_*
# e você NÃO precisa preenchê-las manualmente:
#   MYSQL_ADDON_HOST, MYSQL_ADDON_DB, MYSQL_ADDON_USER, MYSQL_ADDON_PASSWORD, MYSQL_ADDON_PORT
#
# Para rodar localmente (ou em outro provedor), preencha estas variáveis genéricas:
MYSQL_ADDON_HOST=seu-host-mysql.clever-cloud.com
MYSQL_ADDON_DB=seu_banco
MYSQL_ADDON_USER=seu_usuario
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=sua_senha
MYSQL_ADDON_URI=mysql://seu_usuario:sua_senha@seu-host-mysql.clever-cloud.com:3306/seu_banco

# ---- Senhas provisórias do seed inicial (opcional) ----
# Usadas apenas por "node db/seed.js" na primeira vez que o banco é populado.
# Se não definir, o valor padrão "KingStar@2026" é usado para os 3 usuários.
SEED_SENHA_GESTAO=
SEED_SENHA_ADMIN=
SEED_SENHA_OPERADOR=
